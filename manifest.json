{
   "manifest_version": 3,
   "name": "InstaBrake - Explore & Reels Blocker",
   "version": "2.1.0",
   "description": "InstaBrake is a modified and expanded version of the MIT-licensed project originally created by aymyo, designed to help users control social media usage",
   "author": "Matheus Antunes Freire (@mtheusantunes)",
   "permissions": [ "storage" ],
   "action": {
      "default_icon": {
         "16": "public/ib16.png",
         "32": "public/ib32.png",
         "48": "public/ib48.png",
         "128": "public/ib128.png"
      },
      "default_popup": "popup/popup.html",
      "default_title": "InstaBrake Options"
   },
   "options_ui": {
      "open_in_tab": true,
      "page": "popup/popup.html"
   },
   "icons": {
      "16": "public/ib16.png",
      "32": "public/ib32.png",
      "48": "public/ib48.png",
      "128": "public/ib128.png"
   },
   "content_scripts": [
      {
         "js": [ "content.js" ],
         "matches": [ "https://*.instagram.com/*", "https://instagram.com/*" ],
         "run_at": "document_start"
      }
   ],
   "web_accessible_resources": [
      {
         "matches": [ "https://*.instagram.com/*", "https://instagram.com/*" ],
         "resources": [ "interceptor.js" ]
      }
   ]
}
